APP_NAME="Albarq"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain ---

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=info (or error) to avoid noisy debug logs.

DB_CONNECTION=sqlite
# Production (MySQL): DB_CONNECTION=mysql, DB_HOST, DB_PORT=3306, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
# SQLite is local-dev only; use MySQL/Postgres in production.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis (or database) with a supervised `php artisan queue:work`,
# CACHE_STORE=redis, SESSION_DRIVER=database (or redis), BROADCAST_CONNECTION=reverb when realtime is enabled.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Production: MAIL_MAILER=smtp + MAIL_HOST/PORT/USERNAME/PASSWORD, MAIL_FROM_ADDRESS=noreply@your-domain
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storefront (SDG per 1 USD fallback when no active exchange_rates row).
EXCHANGE_RATE_SDG_PER_USD=3000

# Support channels. WhatsApp in international format without "+" (e.g. 2499XXXXXXX).
# Empty hides WhatsApp buttons. Shown on /contact, frozen notice + floating button.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=support@example.com

# Google OAuth (Laravel Socialite). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Reverb websockets. Leave defaults for local; set real values + TLS in production.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
# Comma-separated origins allowed to connect. Production: https://your-domain
REVERB_ALLOWED_ORIGINS=*
# Production: set true to throttle client events.
REVERB_APP_RATE_LIMITING_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
